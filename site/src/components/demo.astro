---
import {
  CheckCheck,
  EllipsisVertical,
  FaceSlightlySmiling,
  Mic,
  PanelLeftClose,
  Phone,
  Plus,
  Search,
  Settings,
  Video,
} from "@lucide/astro";

/**
 * a chat in the chat list
 */
type Chat = {
  name: string;
  preview: string;
  time: string;

  /**
   * unread messages, hidden at 0
   */
  unread?: number;
};

/**
 * a message in the open chat
 */
type Message = {
  text: string;
  time: string;

  /**
   * sent by the account itself
   */
  out?: boolean;

  /**
   * sender shown above messages in groups
   */
  from?: string;
};

/**
 * a made up account shown in the preview
 */
type Account = {
  name: string;
  avatar: string;
  chats: Chat[];

  /**
   * the open chat is always the first one in the list
   */
  messages: Message[];

  /**
   * shown under the open chat's name
   */
  status: string;
};

