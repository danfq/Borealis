---
import { ChevronDown } from "@lucide/astro";
import Section from "./section.astro";

/**
 * common questions, answers may contain inline html
 */
const QUESTIONS = [
  {
    question: "Is Borealis made by WhatsApp?",
    answer:
      "No. Borealis is an independent project and isn't affiliated with WhatsApp or Meta.",
  },
  {
    question: "Is it free?",
    answer:
      'Yes. Borealis is free and open source, licensed under the <a href="https://github.com/danfq/Borealis/blob/main/LICENSE">GNU AGPL v3.0</a>.',
  },
  {
    question: "Can Borealis read my messages?",
    answer:
      "No. Borealis opens WhatsApp Web directly, the same way your browser would. Your messages go straight between you and WhatsApp, and Borealis doesn't collect anything.",
  },
  {
    question: "How do I add an account?",
    answer:
      "Click the <strong>+</strong> button in the sidebar and give the account a name. Then link it like you would WhatsApp Web: open WhatsApp on your phone, go to <strong>Linked devices</strong> and scan the code.",
  },
  {
    question: "How many accounts can I add?",
    answer:
      "As many as you need. Every account stays signed in on its own and is kept completely separate from the others.",
  },
  {
    question: "Do calls work?",
    answer:
      "Yes, on macOS and Windows you can make voice and video calls right from the app. Calls aren't available on Linux yet.",
  },
  {
    question: "Windows warns me about the installer. Is that safe?",
    answer:
      "Windows shows this for apps it doesn't know yet. Choose <strong>More info</strong>, then <strong>Run anyway</strong> to install Borealis.",
  },
];
---

<Section id="faq" eyebrow="FAQ" title="Questions and answers">
  <div class="mx-auto max-w-3xl divide-y divide-white/10 border-y border-white/10">
    {QUESTIONS.map((item) => (
      <details class="group">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 font-medium text-white [&::-webkit-details-marker]:hidden">
          {item.question}
          <ChevronDown class="size-5 shrink-0 text-slate-500 transition-transform group-open:rotate-180" />
        </summary>
        <p
          class="pb-6 leading-relaxed text-pretty text-slate-400 [&_a]:text-white [&_a]:underline [&_a]:underline-offset-4 [&_strong]:font-semibold [&_strong]:text-slate-200"
          set:html={item.answer}
        />
      </details>
    ))}
  </div>
</Section>
