---
/**
 * page section with a centered heading above its content
 */
type Props = {
  id: string;

  /**
   * short label above the title
   */
  eyebrow: string;
  title: string;
  description?: string;
};

const { id, eyebrow, title, description } = Astro.props;
---

<section id={id} class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
  <div class="mx-auto max-w-2xl text-center">
    <p class="text-sm font-semibold tracking-wide text-aurora-teal uppercase">
      {eyebrow}
    </p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-balance text-white sm:text-4xl">
      {title}
    </h2>
    {description && (
      <p class="mt-4 text-lg text-pretty text-slate-400">{description}</p>
    )}
  </div>

  <div class="mt-14 sm:mt-16">
    <slot />
  </div>
</section>
