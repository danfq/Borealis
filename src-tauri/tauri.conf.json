{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Borealis",
  "version": "../package.json",
  "identifier": "dev.danfq.borealis",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Borealis",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "DanFQ",
    "copyright": "© DanFQ",
    "homepage": "https://getborealis.app",
    "shortDescription": "Lightweight multi-account WhatsApp desktop client",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/dbus-1/services/dev.danfq.Borealis.service": "../packaging/dbus/dev.danfq.Borealis.service",
          "/usr/share/plasma/plasmoids/dev.danfq.borealis/metadata.json": "../packaging/plasma/dev.danfq.borealis/metadata.json",
          "/usr/share/plasma/plasmoids/dev.danfq.borealis/contents/ui/main.qml": "../packaging/plasma/dev.danfq.borealis/contents/ui/main.qml",
          "/usr/share/plasma/plasmoids/dev.danfq.borealis/contents/images/icon.svg": "../packaging/plasma/dev.danfq.borealis/contents/images/icon.svg"
        }
      }
    }
  }
}
