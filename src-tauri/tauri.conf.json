{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Borealis",
  "version": "../package.json",
  "identifier": "dev.danfq.borealis",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Borealis",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "DanFQ",
    "copyright": "© DanFQ",
    "homepage": "https://getborealis.app",
    "shortDescription": "Lightweight multi-account WhatsApp desktop client",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
